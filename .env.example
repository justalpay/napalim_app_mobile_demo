# ==============================================================================
# NAPALIM Mobile — Çevre Değişkenleri Şablonu (.env.example)
#
# DİKKAT: Bu dosya yalnızca bir şablondur. Gerçek anahtarlarınızı buraya yazmayın!
# Kendi gizli anahtarlarınız için kök dizinde bir ".env" dosyası oluşturun.
# ".env" dosyası .gitignore tarafından korunur ve ASLA GitHub'a gönderilmez.
# ==============================================================================

# Backend API Bağlantısı
EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_WS_URL=ws://localhost:5000

# Google Maps API (Gerekli olduğunda)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# AI / LLM Servisleri (Backend üzerinden çağrılması önerilir)
# OPENAI_API_KEY=your_openai_key_here
# GEMINI_API_KEY=your_gemini_key_here

# Supabase Entegrasyonu (Kullanılacaksa)
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
